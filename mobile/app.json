{
  "expo": {
    "name": "Hangout Map",
    "slug": "hangout-map",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "hangout",
    "ios": {
      "bundleIdentifier": "com.hangout.map",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hangout.map",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Hangout Map to center the map on nearby gatherings."
        }
      ],
      "expo-image-picker",
      "expo-status-bar",
      "expo-video",
      "expo-font",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ]
  }
}
